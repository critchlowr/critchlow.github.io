{
	// SvelteKit writes this base config into node_modules when it syncs. It sets
	// the module options, including .ts extensions on imports, which the tests
	// need because they run on Node directly.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "tests", "vite.config.ts"]
}
