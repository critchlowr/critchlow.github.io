{
	"name": "ryancritchlow-portfolio",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"preview:test": "vite preview --port 4173",
		"contrast": "node scripts/check-contrast.mjs",
		"pa11y": "start-server-and-test preview:test http://localhost:4173 \"pa11y-ci\"",
		"axe": "start-server-and-test preview:test http://localhost:4173 \"node scripts/a11y-audit.mjs\"",
		"a11y:tree": "start-server-and-test preview:test http://localhost:4173 \"node scripts/a11y-tree.mjs\"",
		"a11y": "npm run contrast && npm run pa11y && npm run axe"
	},
	"devDependencies": {
		"@axe-core/cli": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.0.0",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"pa11y-ci": "^4.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"start-server-and-test": "^3.0.12",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.67.0",
		"vite": "^6.0.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0"
	}
}
