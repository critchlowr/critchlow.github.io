{
	"name": "ryancritchlow-portfolio",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "node --test \"tests/**/*.test.ts\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"preview:test": "vite preview --port 4173 --strictPort",
		"pa11y": "start-server-and-test preview:test http://localhost:4173 \"pa11y-ci\"",
		"axe": "start-server-and-test preview:test http://localhost:4173 \"node scripts/a11y-audit.mjs\"",
		"a11y": "npm run pa11y && npm run axe"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"axe-core": "^4.14.0",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"pa11y-ci": "^5.0.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"start-server-and-test": "^3.0.13",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.3.8"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0"
	}
}
